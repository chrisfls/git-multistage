{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook gemini"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "^(write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook gemini"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "^(write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook gemini"
          }
        ]
      }
    ]
  }
}
