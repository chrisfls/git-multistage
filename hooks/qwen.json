{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook qwen"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook qwen"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook qwen"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook qwen"
          }
        ]
      }
    ]
  }
}
