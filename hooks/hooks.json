{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|apply_patch",
        "hooks": [{"type": "command", "command": "git multistage hook"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|apply_patch",
        "hooks": [{"type": "command", "command": "git multistage hook"}]
      }
    ]
  }
}
