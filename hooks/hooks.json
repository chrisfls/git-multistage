{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "git multistage hook"
          }
        ]
      }
    ]
  }
}
