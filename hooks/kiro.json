{
  "version": "v1",
  "hooks": [
    {
      "name": "git-multistage-session-start",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "git multistage hook kiro"
      }
    },
    {
      "name": "git-multistage-before-edit",
      "trigger": "PreToolUse",
      "matcher": "^(fs_write|fs_append|str_replace|write)$",
      "action": {
        "type": "command",
        "command": "git multistage hook kiro"
      }
    },
    {
      "name": "git-multistage-after-edit",
      "trigger": "PostToolUse",
      "matcher": "^(fs_write|fs_append|str_replace|write)$",
      "action": {
        "type": "command",
        "command": "git multistage hook kiro"
      }
    }
  ]
}
