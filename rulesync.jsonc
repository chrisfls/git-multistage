{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // The codexcli rules write AGENTS.md. RuleSync uses AGENTS.md as the root
  // rule file of Antigravity, OpenCode, Devin, and Grok, and Claude Code and
  // Cursor read it too, so only codexcli takes the rules.
  "targets": {
    "codexcli": ["rules", "skills"],
    "claudecode": ["skills"],
    "antigravity-cli": ["skills"],
    "opencode": ["skills"],
    "cursor": ["skills"],
    "devin": ["skills"],
    "grokcli": ["skills"]
  },
  "delete": true,
  "global": false,
  "sources": [
    {
      // Go skills that apply to a standard-library CLI. The framework and
      // library skills, such as cobra, grpc, and samber/lo, are left out.
      "source": "samber/cc-skills-golang",
      "skills": [
        "golang-benchmark",
        "golang-cli",
        "golang-code-style",
        "golang-concurrency",
        "golang-context",
        "golang-continuous-integration",
        "golang-data-structures",
        "golang-dependency-management",
        "golang-design-patterns",
        "golang-documentation",
        "golang-error-handling",
        "golang-gopls",
        "golang-lint",
        "golang-modernize",
        "golang-naming",
        "golang-performance",
        "golang-project-layout",
        "golang-refactoring",
        "golang-safety",
        "golang-security",
        "golang-structs-interfaces",
        "golang-testing",
        "golang-troubleshooting"
      ]
    },
    {
      // The core OpenSpec workflow. The ref matches the installed
      // `openspec` CLI, which the skills run.
      "source": "Fission-AI/OpenSpec",
      "ref": "v2.0.0",
      "skills": [
        "openspec-explore",
        "openspec-propose",
        "openspec-apply-change",
        "openspec-update-change",
        "openspec-sync-specs",
        "openspec-archive-change"
      ]
    }
  ]
}
